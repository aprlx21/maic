MAIC_MODE=demo
OPENAI_API_KEY=
MAIC_MODEL=gpt-6-luna
MAIC_DATA_DIR=./data
MAIC_DATABASE_URL=sqlite:///./data/app.db
MAIC_CHECKPOINT_URL=sqlite:///./data/checkpoints.db
MAIC_STORAGE=local
MAIC_MAX_PDF_MB=30
MAIC_MAX_PAGES=100
MAIC_MAX_SLIDES=20
MAIC_MAX_AUTO_ROUNDS=0
MAIC_MAX_MODEL_CALLS=90
MAIC_MAX_INPUT_TOKENS=1000000
MAIC_MAX_OUTPUT_TOKENS=40000
MAIC_MAX_CALL_INPUT_TOKENS=32000
MAIC_MAX_CALL_OUTPUT_TOKENS=12000
MAIC_CONTEXT_TOKENS=4000
MAIC_SCRIPT_BATCH_SIZE=8
# Additional image requests are separate from text token budgets.
MAIC_IMAGE_MODEL=gpt-image-2
MAIC_MAX_SLIDE_IMAGES=6
MAIC_MAX_AI_IMAGES=2
MAIC_MAX_JOB_SECONDS=1800
# Set provider rates to enable cost estimates; never assumed to be current prices.
MAIC_INPUT_USD_PER_MILLION=
MAIC_CACHED_INPUT_USD_PER_MILLION=
MAIC_OUTPUT_USD_PER_MILLION=
MAIC_SOFFICE=
MAIC_TESSDATA_PREFIX=
MAIC_OCR_LANGUAGES=vie+eng
MAIC_SLIDE_FONT=Noto Sans
